<Window x:Class="SistemaControlAsistencia.App.Views.UsuarioFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usuario" Height="500" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock x:Name="TxtTitulo" Text="Nuevo usuario" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Text="Nombre" FontSize="12" Foreground="{StaticResource ColorTextoSecundario}"/>
        <TextBox x:Name="TxtNombre" Style="{StaticResource CampoTexto}" Margin="0,2,0,10"/>

        <TextBlock Text="Apellidos" FontSize="12" Foreground="{StaticResource ColorTextoSecundario}"/>
        <TextBox x:Name="TxtApellidos" Style="{StaticResource CampoTexto}" Margin="0,2,0,10"/>

        <TextBlock Text="Correo electrónico" FontSize="12" Foreground="{StaticResource ColorTextoSecundario}"/>
        <TextBox x:Name="TxtCorreo" Style="{StaticResource CampoTexto}" Margin="0,2,0,10"/>

        <TextBlock x:Name="TxtEtiquetaContrasena" Text="Contraseña inicial" FontSize="12" Foreground="{StaticResource ColorTextoSecundario}"/>
        <PasswordBox x:Name="PwdContrasena" Style="{StaticResource CampoContrasena}" Margin="0,2,0,10"/>

        <TextBlock Text="Rol" FontSize="12" Foreground="{StaticResource ColorTextoSecundario}"/>
        <ComboBox x:Name="CmbRol" Margin="0,2,0,10" Padding="8">
            <ComboBoxItem Content="Administrador"/>
            <ComboBoxItem Content="Empleado"/>
        </ComboBox>

        <CheckBox x:Name="ChkActivo" Content="Usuario activo" IsChecked="True" Margin="0,4,0,10"/>

        <TextBlock x:Name="TxtMensajeError" Foreground="{StaticResource ColorError}" TextWrapping="Wrap"
                   Margin="0,4,0,10" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}" Width="100" Margin="0,0,10,0" Click="BtnCancelar_Click"/>
            <Button x:Name="BtnGuardar" Content="Guardar" Style="{StaticResource BotonPrimario}" Width="100" Click="BtnGuardar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
