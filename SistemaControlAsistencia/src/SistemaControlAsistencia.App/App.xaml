<Application x:Class="SistemaControlAsistencia.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="ColorAzulMarino" Color="#0F1F3D"/>
            <SolidColorBrush x:Key="ColorAzulCorporativo" Color="#1B4B8F"/>
            <SolidColorBrush x:Key="ColorAzulClaro" Color="#E8F0FB"/>
            <SolidColorBrush x:Key="ColorGrisClaro" Color="#F4F6F9"/>
            <SolidColorBrush x:Key="ColorBorde" Color="#DDE3EC"/>
            <SolidColorBrush x:Key="ColorTextoPrincipal" Color="#1A1F29"/>
            <SolidColorBrush x:Key="ColorTextoSecundario" Color="#5B6472"/>
            <SolidColorBrush x:Key="ColorExito" Color="#1E7E34"/>
            <SolidColorBrush x:Key="ColorError" Color="#C0392B"/>

            <Style TargetType="Button" x:Key="BotonPrimario">
                <Setter Property="Background" Value="{StaticResource ColorAzulCorporativo}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.9"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="Button" x:Key="BotonSecundario" BasedOn="{StaticResource BotonPrimario}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource ColorAzulCorporativo}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorAzulCorporativo}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style TargetType="Button" x:Key="BotonMenu">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="18,12"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="fondo" Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="fondo" Property="Background" Value="#1B2C4F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBox" x:Key="CampoTexto">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Background" Value="White"/>
            </Style>

            <Style TargetType="PasswordBox" x:Key="CampoContrasena">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Background" Value="White"/>
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="RowHeight" Value="36"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ColorBorde}"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
