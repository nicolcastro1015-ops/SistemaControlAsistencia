<UserControl x:Class="SistemaControlAsistencia.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ColorTextoPrincipal}"/>
        <TextBlock Text="Resumen general de la empresa" Foreground="{StaticResource ColorTextoSecundario}" Margin="0,2,0,20"/>

        <UniformGrid Columns="4" Rows="1">
            <Border Background="White" CornerRadius="8" Margin="0,0,12,0" Padding="16" BorderBrush="{StaticResource ColorBorde}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Empleados activos" Foreground="{StaticResource ColorTextoSecundario}" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalActivos" FontSize="30" FontWeight="Bold" Foreground="{StaticResource ColorAzulCorporativo}"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Margin="0,0,12,0" Padding="16" BorderBrush="{StaticResource ColorBorde}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Presentes hoy" Foreground="{StaticResource ColorTextoSecundario}" FontSize="12"/>
                    <TextBlock x:Name="TxtPresentesHoy" FontSize="30" FontWeight="Bold" Foreground="{StaticResource ColorExito}"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Margin="0,0,12,0" Padding="16" BorderBrush="{StaticResource ColorBorde}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Atrasos hoy" Foreground="{StaticResource ColorTextoSecundario}" FontSize="12"/>
                    <TextBlock x:Name="TxtAtrasosHoy" FontSize="30" FontWeight="Bold" Foreground="#B8860B"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource ColorBorde}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Salidas anticipadas hoy" Foreground="{StaticResource ColorTextoSecundario}" FontSize="12"/>
                    <TextBlock x:Name="TxtSalidasHoy" FontSize="30" FontWeight="Bold" Foreground="{StaticResource ColorError}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Text="Actividad reciente" FontSize="16" FontWeight="Bold" Margin="0,24,0,8"/>
        <Border Background="White" CornerRadius="8" BorderBrush="{StaticResource ColorBorde}" BorderThickness="1">
            <DataGrid x:Name="GridActividadReciente" MaxHeight="280">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding NombreCompleto}" Width="2*"/>
                    <DataGridTextColumn Header="Acción" Binding="{Binding Accion}" Width="1*"/>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="1*"/>
                    <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="1*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <TextBlock x:Name="TxtSinActividad" Text="Aún no hay registros de asistencia hoy." Foreground="{StaticResource ColorTextoSecundario}"
                   Margin="0,8,0,0" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
